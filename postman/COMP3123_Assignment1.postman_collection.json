    {
      "name": "7. Rate limiting",
      "item": [
        {
          "name": "Login - Repeat until rate limited (429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"rlCount\") || 0) + 1;",
                  "pm.collectionVariables.set(\"rlCount\", n);",
                  "if (pm.response.code !== 429 && n < 20) { postman.setNextRequest(pm.info.requestName); }",
                  "else { pm.test(\"Status code is 429 (Too Many Requests)\", () => pm.response.to.have.status(429)); pm.collectionVariables.unset(\"rlCount\"); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Repeats itself (via setNextRequest) until the auth limiter returns 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nobody\",\n  \"password\": \"WrongPass999\"\n}",
